{
    "application": {
        "name": "EMS-OPG",
        "version": "1.0.0",
        "environment": "development"
    },
    "database": {
        "type": "sqlite",
        "filename": "traceability_db.db",
        "auto_backup": true
    },
    "logging": {
        "level": "INFO",
        "directory": "logs",
        "max_log_size_mb": 10,
        "backup_count": 5
    },
    "backup": {
        "enabled": true,
        "directory": "backup",
        "backup_on_startup": true,
        "backup_on_shutdown": false
    },
    "paths": {
        "assets": "assets",
        "exports": "exports",
        "database": "database",
        "qr_cache": "cache/qr"
    },
    "window": {
        "width": 1400,
        "height": 900,
        "maximize": true
    },
    "workflow": {
        "confirm_before_finish": true,
        "allow_cancel": true
    },

    "qr_commands": {
        "step3": "ls /dev/sd[a-e]",

        "step4": "timeout 2s loopback /dev/port0[2-4] -q", 

        "step5": "timeout 2s loopback /dev/port0[5-8] -q",

        "step6": "ifconfig eth1 up && sleep 5 && ethtool eth1",

        "step7": "emd -i sysfc",
        
        "step8": "setfset -u ethaddr={mac1}",
        
        "step9": "setfset -u eth1addr={mac2}",
        
        "step10": "echo \"MAC1: {mac1}\" && echo \"MAC2: {mac2}\""

    },

    "combined_steps": {
        "functional_test": [
            "step3",
            "step5",
            "step4",
            "step6"
        ],

        "combined_macs": [
            "step8",
            "step9"
        ],

        "complete_test": [
            "step3",
            "step4",
            "step5",
            "step6",
            "step8",
            "step9",
            "step10"
        ]
    }

}