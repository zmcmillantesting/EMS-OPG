{
    "application": {
        "name": "EMS-OPG",
        "version": "1.0.0",
        "environment": "development"
    },
    "database": {
        "type": "sqlite",
        "filename": "traceability_db.db",
        "auto_backup": true
    },
    "logging": {
        "level": "INFO",
        "directory": "logs",
        "max_log_size_mb": 10,
        "backup_count": 5
    },
    "backup": {
        "enabled": true,
        "directory": "backup",
        "backup_on_startup": true,
        "backup_on_shutdown": false
    },
    "paths": {
        "assets": "assets",
        "exports": "exports",
        "database": "database",
        "qr_cache": "cache/qr"
    },
    "window": {
        "width": 1400,
        "height": 900,
        "maximize": true
    },
    "workflow": {
        "confirm_before_finish": true,
        "allow_cancel": true
    },
    "qr_commands": {
        "step1": "root",
        "step2": "default",
        "step3": "ls /dev/sd[a-e]",
        "step4": "timeout 2s loopback /dev/port0[2-4] -q",
        "step5": "timeout 2s loopback /dev/port0[5-8] -q",
        "step6": "ifconfig eth1 up && sleep 5 && ethtool eth1",
        "step7": "echo 1 | tee /sys/class/leds/acm7000:green:sig_*/brightness",
        "step8": "emd -i sysfs -c 4",
        "step9": "setfset -u ethaddr={mac1}",
        "step10": "setfset -u eth1addr={mac2}",
        "step11": "setfset | grep eth0 && setfset | grep eth1"
    },
    "combined_steps": {
        "functional_test": [
            "step3",
            "step4",
            "step5",
            "step7",
            "step8",
            "step6"
        ],
        "combined_macs": [
            "step9",
            "step10"
        ],
        "complete_test": [
            "step3",
            "step4",
            "step5",
            "step6",
            "step7",
            "step8",
            "step9",
            "step10"
        ]
    }
}